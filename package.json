{
  "name": "vue-mid-level-certification-practice",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  },
  "scripts": {
    "test": "pnpm -r --no-bail --if-present test",
    "test:exercises": "pnpm --filter \"./packages/*\" --if-present test",
    "test:solutions": "pnpm --filter \"./solutions/*\" --if-present test",
    "test:watch": "pnpm -r --if-present test --watch",
    "typecheck": "pnpm -r --no-bail --if-present typecheck",
    "sync:tests": "./scripts/sync-tests.sh",
    "sync:tests:check": "./scripts/sync-tests.sh check",
    "build": "pnpm -r --if-present build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "dev:01": "pnpm --filter 01-scroll-to-item dev",
    "dev:02": "pnpm --filter 02-shopping-list dev",
    "dev:03": "pnpm --filter 03-search-users dev",
    "dev:04": "pnpm --filter 04-sort-products dev",
    "dev:05": "pnpm --filter 05-counter-history dev",
    "dev:06": "pnpm --filter 06-base-input dev",
    "dev:07": "pnpm --filter 07-data-table-slots dev",
    "dev:08": "pnpm --filter 08-theme-provider dev",
    "dev:09": "pnpm --filter 09-router-master-detail dev",
    "dev:10": "pnpm --filter 10-pinia-cart dev",
    "dev:11": "pnpm --filter 11-async-search dev",
    "dev:12": "pnpm --filter 12-composable-storage dev",
    "dev:13": "pnpm --filter 13-accordion dev",
    "dev:14": "pnpm --filter 14-tabs dev",
    "dev:15": "pnpm --filter 15-dynamic-form dev",
    "dev:16": "pnpm --filter 16-rating dev",
    "dev:17": "pnpm --filter 17-modal dev",
    "dev:18": "pnpm --filter 18-notification-queue dev",
    "dev:19": "pnpm --filter 19-pagination dev",
    "dev:20": "pnpm --filter 20-infinite-scroll dev",
    "dev:21": "pnpm --filter 21-use-countdown dev",
    "dev:22": "pnpm --filter 22-use-fetch dev",
    "dev:23": "pnpm --filter 23-clipboard dev",
    "dev:24": "pnpm --filter 24-pinia-wishlist dev",
    "dev:25": "pnpm --filter 25-pinia-auth-guard dev",
    "dev:26": "pnpm --filter 26-dashboard-stats dev",
    "dev:27": "pnpm --filter 27-query-filters dev",
    "dev:28": "pnpm --filter 28-breadcrumbs dev",
    "dev:29": "pnpm --filter 29-debug-reactivity dev",
    "dev:30": "pnpm --filter 30-debug-emits-store dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
